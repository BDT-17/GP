# ==============================================================================
# MASCOT - Multi-Agent LLM Configuration
# ==============================================================================
# Set any of the following API keys to enable live AI responses for
# Peer Student (Bảo), Teaching Assistant (Thầy Hùng), and Lecturer (TS. Minh).
# If no key is set, MASCOT automatically runs in deterministic Fallback Mode.

# 1. Google Gemini (Recommended - Free Tier available at aistudio.google.com)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# 2. Groq (Ultra-Fast Cloud Inference - Free Tier available at console.groq.com)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# 4. Local Ollama (Completely Local & Free)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3

